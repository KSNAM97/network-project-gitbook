! cisco
!
hostname br1-r1
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 12.12.12.1 255.255.255.255
!
int gi0/0
 desc to br1-sw1-l3 gi0/0
 ip addr 10.3.0.1 255.255.255.252
 no sh
!
int gi1/0
 desc to br1-sw2-l3 gi0/0
 ip addr 10.3.0.9 255.255.255.252
 no sh
!
int gi2/0
 desc to br1-r2 gi2/0
 ip addr 10.3.0.17 255.255.255.252
 no sh
!
int gi3/0
 desc to isp-1-pe-b gi2/0
 ip addr 100.1.31.1 255.255.255.252
 no sh
!
int gi4/0
 desc to private-net gi3/0
 ip addr 203.0.113.13 255.255.255.252
 no sh
!
router ospf 12
 router-id 12.12.12.1
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
 no passive-interface gi2/0
!
int lo0
 ip ospf 12 area 2
!
int gi0/0
 ip ospf 12 area 2
 ip ospf network point-to-point
!
int gi1/0
 ip ospf 12 area 2
 ip ospf network point-to-point
!
int gi2/0
 ip ospf 12 area 2
 ip ospf network point-to-point
!
router ospf 2
 router-id 203.0.113.13
 passive-interface default
 no passive-interface gi4/0
!
int gi4/0
 ip ospf 2 area 100
 ip ospf network point-to-point
!
ip route 10.3.0.0 255.255.0.0 null0
ip prefix-list pl-site seq 5 permit 10.3.0.0/16
ip prefix-list pl-default seq 5 permit 0.0.0.0/0
route-map rm-isp-out permit 10
 match ip address prefix-list pl-site
route-map rm-isp-in permit 10
 match ip address prefix-list pl-default
!
router bgp 65003
 bgp router-id 12.12.12.1
 bgp log-neighbor-changes
 no auto-summary
 no synchronization
 neighbor 100.1.31.2 remote-as 65100
 neighbor 100.1.31.2 timers 3 9
 neighbor 100.1.31.2 route-map rm-isp-in in
 neighbor 100.1.31.2 route-map rm-isp-out out
 network 10.3.0.0 mask 255.255.0.0
!
router ospf 12
 default-information originate metric 100 metric-type 1
!
crypto isakmp policy 10
 encryption aes 256
 hash sha
 authentication pre-share
 group 5
 lifetime 86400
crypto isakmp key dmvpn-hub address 0.0.0.0 0.0.0.0
crypto isakmp keepalive 10 3
crypto ipsec transform-set ts-aes256 esp-aes 256 esp-sha-hmac
 mode tunnel
crypto ipsec profile dmvpn-profile
 set transform-set ts-aes256
 set pfs group5
 set security-association lifetime seconds 3600
!
int tunnel0
 desc dmvpn spoke
 ip addr 172.16.0.11 255.255.255.0
 ip mtu 1400
 ip tcp adjust-mss 1360
 tunnel source gi4/0
 tunnel mode gre multipoint
 tunnel key 100
 ip nhrp network-id 100
 ip nhrp holdtime 600
 ip nhrp authentication nhrpkey1
 ip nhrp nhs 172.16.0.1
 ip nhrp map 172.16.0.1 203.0.113.5
 ip nhrp map multicast 203.0.113.5
 ip nhrp shortcut
 ip ospf 12 area 0
 ip ospf network broadcast
 ip ospf priority 0
 tunnel protection ipsec profile dmvpn-profile shared
!
router ospf 12
 no passive-interface tunnel 0
!
ip access-list extended acl-qos-dns
 permit udp any any eq 53
 permit udp any eq 53 any
 permit tcp any any eq 53
 permit tcp any eq 53 any
!
class-map match-any cm-control
 match dscp cs6
class-map match-any cm-business
 match access-group name acl-qos-dns
!
policy-map pm-lan-out-child
 class cm-control
  bandwidth percent 10
 class cm-business
  bandwidth percent 30
  set dscp af31
 class class-default
  fair-queue
policy-map pm-lan-out
 class class-default
  shape average 10000000
  service-policy pm-lan-out-child
!
int gi0/0
 service-policy output pm-lan-out
int gi1/0
 service-policy output pm-lan-out
!