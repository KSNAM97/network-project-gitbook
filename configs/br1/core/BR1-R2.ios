! cisco
!
hostname br1-r2
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 12.12.12.2 255.255.255.255
!
int gi0/0
 desc to br1-sw1-l3 gi0/1
 ip addr 10.3.0.6 255.255.255.252
 no sh
!
int gi1/0
 desc to br1-sw2-l3 gi0/1
 ip addr 10.3.0.13 255.255.255.252
 no sh
!
int gi2/0
 desc to br1-r1 gi2/0
 ip addr 10.3.0.18 255.255.255.252
 no sh
!
int gi3/0
 desc to isp-2-pe-b gi2/0
 ip addr 100.2.32.1 255.255.255.252
 no sh
!
router ospf 12
 router-id 12.12.12.2
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
 no passive-interface gi2/0
!
int lo0
 ip ospf 12 area 2
!
int gi0/0
 ip ospf 12 area 2
 ip ospf network point-to-point
!
int gi1/0
 ip ospf 12 area 2
 ip ospf network point-to-point
!
int gi2/0
 ip ospf 12 area 2
 ip ospf network point-to-point
!
ip route 10.3.0.0 255.255.0.0 null0
ip prefix-list pl-site seq 5 permit 10.3.0.0/16
ip prefix-list pl-default seq 5 permit 0.0.0.0/0
route-map rm-isp-out permit 10
 match ip address prefix-list pl-site
route-map rm-isp-in permit 10
 match ip address prefix-list pl-default
!
router bgp 65003
 bgp router-id 12.12.12.2
 bgp log-neighbor-changes
 no auto-summary
 no synchronization
 neighbor 100.2.32.2 remote-as 65200
 neighbor 100.2.32.2 timers 3 9
 neighbor 100.2.32.2 route-map rm-isp-in in
 neighbor 100.2.32.2 route-map rm-isp-out out
 network 10.3.0.0 mask 255.255.0.0
!
router ospf 12
 default-information originate metric 200 metric-type 1
!
ip access-list extended acl-qos-dns
 permit udp any any eq 53
 permit udp any eq 53 any
 permit tcp any any eq 53
 permit tcp any eq 53 any
!
class-map match-any cm-control
 match dscp cs6
class-map match-any cm-business
 match access-group name acl-qos-dns
!
policy-map pm-lan-out-child
 class cm-control
  bandwidth percent 10
 class cm-business
  bandwidth percent 30
  set dscp af31
 class class-default
  fair-queue
policy-map pm-lan-out
 class class-default
  shape average 10000000
  service-policy pm-lan-out-child
!
int gi0/0
 service-policy output pm-lan-out
int gi1/0
 service-policy output pm-lan-out
!