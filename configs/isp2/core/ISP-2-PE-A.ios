! cisco
!
hostname isp-2-pe-a
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 200.200.200.1 255.255.255.255
!
int gi0/0
 desc to isp-2-p1 gi0/0
 ip addr 100.2.0.1 255.255.255.252
 no sh
!
int gi1/0
 desc to isp-2-p2 gi0/0
 ip addr 100.2.0.5 255.255.255.252
 no sh
!
int gi2/0
 desc to hq-r2 gi3/0
 ip addr 100.2.12.2 255.255.255.252
 no sh
!
int gi3/0
 desc to dc-r4 gi3/0
 ip addr 100.2.22.2 255.255.255.252
 no sh
!
router ospf 1
 router-id 200.200.200.1
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
!
int lo0
 ip ospf 1 area 0
int gi0/0
 ip ospf 1 area 0
 ip ospf network point-to-point
int gi1/0
 ip ospf 1 area 0
 ip ospf network point-to-point
!
router bgp 65200
 bgp router-id 200.200.200.1
 bgp log-neighbor-changes
 no auto-summary
 no synchronization
 neighbor 200.200.200.2 remote-as 65200
 neighbor 200.200.200.2 update-source lo0
 neighbor 200.200.200.2 timers 3 9
 neighbor 200.200.200.2 next-hop-self
 neighbor 200.200.200.3 remote-as 65200
 neighbor 200.200.200.3 update-source lo0
 neighbor 200.200.200.3 timers 3 9
 neighbor 200.200.200.3 next-hop-self
!
mpls label protocol ldp
mpls ldp router-id loopback 0
mpls label range 21000 21999
!
int gi0/0
 mpls ip
int gi1/0
 mpls ip
!
ip vrf corp
 rd 65200:1
 route-target export 65200:1
 route-target import 65200:1
!
int gi2/0
 ip vrf forwarding corp
 ip addr 100.2.12.2 255.255.255.252
int gi3/0
 ip vrf forwarding corp
 ip addr 100.2.22.2 255.255.255.252
!
router bgp 65200
 address-family vpnv4
  neighbor 200.200.200.2 activate
  neighbor 200.200.200.2 send-community extended
  neighbor 200.200.200.3 activate
  neighbor 200.200.200.3 send-community extended
 exit-address-family
!
ip prefix-list pl-hq-in seq 5 permit 10.1.0.0/16
ip prefix-list pl-deny-all seq 5 deny 0.0.0.0/0 le 32
!
router bgp 65200
 address-family ipv4 vrf corp
  neighbor 100.2.12.1 remote-as 65001
  neighbor 100.2.12.1 activate
  neighbor 100.2.12.1 timers 3 9
  neighbor 100.2.12.1 prefix-list pl-hq-in in
  neighbor 100.2.12.1 prefix-list pl-deny-all out
  neighbor 100.2.12.1 default-originate
 exit-address-family
!
ip prefix-list pl-dc-in seq 5 permit 10.2.0.0/16
ip prefix-list pl-deny-all seq 5 deny 0.0.0.0/0 le 32
!
router bgp 65200
 address-family ipv4 vrf corp
  neighbor 100.2.22.1 remote-as 65002
  neighbor 100.2.22.1 activate
  neighbor 100.2.22.1 timers 3 9
  neighbor 100.2.22.1 prefix-list pl-dc-in in
  neighbor 100.2.22.1 prefix-list pl-deny-all out
  neighbor 100.2.22.1 default-originate
 exit-address-family
!