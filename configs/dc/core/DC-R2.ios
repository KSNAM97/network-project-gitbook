! cisco
!
hostname dc-r2
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 10.10.10.2 255.255.255.255
!
int gi0/0
 desc to dc-sw1-l3 et2
 ip addr 10.2.0.10 255.255.255.252
 no sh
!
int gi1/0
 desc to dc-sw2-l3 et2
 ip addr 10.2.0.13 255.255.255.252
 no sh
!
int gi2/0
 desc to private-net gi1/0
 ip addr 203.0.113.5 255.255.255.252
 no sh
!
router ospf 10
 router-id 10.10.10.2
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
!
int lo0
 ip ospf 10 area 0
!
int gi0/0
 ip ospf 10 area 0
 ip ospf network point-to-point
int gi1/0
 ip ospf 10 area 0
 ip ospf network point-to-point
!
router ospf 2
 router-id 203.0.113.5
 passive-interface default
 no passive-interface gi2/0
!
int gi2/0
 ip ospf 2 area 100
 ip ospf network point-to-point
!
crypto isakmp policy 10
 encryption aes 256
 hash sha
 authentication pre-share
 group 5
 lifetime 86400
crypto isakmp key dmvpn-hub address 0.0.0.0 0.0.0.0
crypto isakmp keepalive 10 3
crypto ipsec transform-set ts-aes256 esp-aes 256 esp-sha-hmac
 mode tunnel
crypto ipsec profile dmvpn-profile
 set transform-set ts-aes256
 set pfs group5
 set security-association lifetime seconds 3600
!
int tunnel 0
 desc dmvpn hub
 ip addr 172.16.0.1 255.255.255.0
 ip mtu 1400
 ip tcp adjust-mss 1360
 tunnel source gi2/0
 tunnel mode gre multipoint
 tunnel key 100
 ip nhrp network-id 100
 ip nhrp holdtime 600
 ip nhrp authentication nhrpkey1
 ip nhrp map multicast dynamic
 ip nhrp redirect
 ip ospf network broadcast
 ip ospf priority 255
 ip ospf 10 area 0
 tunnel protection ipsec profile dmvpn-profile shared
 no sh
!
router ospf 10
 no passive-interface tunnel 0
!
ip access-list extended dns-only
 permit udp any host 10.2.50.10 eq 53
 permit tcp any host 10.2.50.10 eq 53
 permit udp any host 10.2.50.11 eq 53
 permit tcp any host 10.2.50.11 eq 53
 deny ip any 10.2.50.0 0.0.0.255 log
 permit ip any any
!
int gi0/0
 ip access-group dns-only out
int gi1/0
 ip access-group dns-only out
!
ip access-list extended acl-qos-dns
 permit udp any any eq 53
 permit udp any eq 53 any
 permit tcp any any eq 53
 permit tcp any eq 53 any
!
class-map match-any cm-control
 match dscp cs6
class-map match-any cm-business
 match access-group name acl-qos-dns
!
policy-map pm-lan-out-child
 class cm-control
  bandwidth percent 10
 class cm-business
  bandwidth percent 30
  set dscp af31
 class class-default
  fair-queue
policy-map pm-lan-out
 class class-default
  shape average 10000000
  service-policy pm-lan-out-child
!
int gi0/0
 service-policy output pm-lan-out
int gi1/0
 service-policy output pm-lan-out
!